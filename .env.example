# EarthLink server runtime settings
EARTHLINK_DB_HOST=localhost
EARTHLINK_DB_PORT=5432
EARTHLINK_DB_USER=earthlink
EARTHLINK_DB_PASSWORD=earthlink
EARTHLINK_DB_NAME=earthlink

EARTHLINK_HOST=0.0.0.0
EARTHLINK_PORT=8000

# World stream transport (WebTransport / QUIC)
EARTHLINK_WT_HOST=0.0.0.0
EARTHLINK_WT_PORT=4433
EARTHLINK_WT_PATH=/wt/world
EARTHLINK_WT_CERT_PATH=/certs/dev-cert.pem
EARTHLINK_WT_KEY_PATH=/certs/dev-key.pem
EARTHLINK_WT_PUBLIC_URL=https://wt.localhost/wt/world
